# EditorConfig - root. https://aka.ms/editorconfigdocs
root = true

# ---------- All files ----------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,md,cjs,mjs,ts,tsx,js,jsx}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

# ---------- Generated code ----------
# src/Whisparr2.Net/ is openapi-generator output. Ordering here is load-bearing, because a later
# section wins. This general section must stay below the formatting sections above, and the csproj
# exclusion must stay below this one.
#
# What this setting does, measured: it covers ANALYZER diagnostics (CAxxxx, IDExxxx) over the
# generated files, which carry no // <auto-generated> header. It suppresses no compiler diagnostic
# at all. The warning policy in Directory.Build.props is where compiler diagnostics are decided.
[src/Whisparr2.Net/**]
generated_code = true

# The hand-owned Whisparr2.Net.csproj is the one file in that directory that is not generated, so
# the classification above is wrong for it. Analyzer coverage over a csproj is near-empty, which
# makes this low impact and not optional: the classification is what a reader and a tool both go
# by, and this csproj is hand-owned.
[src/Whisparr2.Net/*.csproj]
generated_code = false
