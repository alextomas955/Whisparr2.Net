<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No TargetFramework element on purpose. Directory.Build.props sets the plural
         TargetFrameworks, and setting the singular one alongside it leaves the build green while
         the test runner reports that no test is available. Omitting it cross-targets, so the whole
         suite runs once per target framework. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- PackageId is inherited from Directory.Build.props and applies whatever IsPackable says, so
         without this line restore fails with "Ambiguous project name 'Whisparr2.Net'". -->
    <PackageId>$(MSBuildProjectName)</PackageId>
    <!-- The root props turn documentation generation on for the library, and an undocumented
         public test class then produces CS1591 as an error under TreatWarningsAsErrors. A test
         assembly ships no documentation, so there is nothing for the diagnostic to be about.
         Turning generation off here is narrower than adding CS1591 to the root NoWarn, which
         would also stop the diagnostic firing for src/hand-written/, and that is public surface
         which must stay documented. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The template also offers a coverage collector. Nothing here collects coverage, so it is
         dropped rather than installed and ignored. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- Testcontainers drives the Docker daemon from this process. It is test-only and never
         reaches the shipped package. Xunit.SkippableFact supplies the dynamic skip that xunit 2.x
         has no native equivalent for, which is what lets a machine without Docker build green. -->
    <PackageReference Include="Testcontainers" Version="4.14.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The image digest, the expected version and the expected branch all come from PROVENANCE.json,
       and the key comes from the one committed seed, so a pin move carries all of them in a single
       commit and nothing here restates a pinned value. The logical names are explicit because the
       name MSBuild derives for a file outside the project directory is not guessable, and a
       mistyped Include is a build error while a mistyped LogicalName is a run-time failure.
       config.seed.xml is read back as bytes and copied into the container unchanged. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\spec\PROVENANCE.json" LogicalName="PROVENANCE.json" />
    <EmbeddedResource Include="..\..\generator\config.seed.xml" LogicalName="config.seed.xml" />
  </ItemGroup>

  <!-- This reference, plus direct calls to AddWhisparr2, is what makes an uncompiled hand-written
       directory a hard build error here instead of a green suite that tested nothing. Do not test
       through an intermediate abstraction and do not copy the hand-written sources in. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Whisparr2.Net\Whisparr2.Net.csproj" />
  </ItemGroup>

</Project>
