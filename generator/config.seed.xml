<?xml version="1.0" encoding="UTF-8"?>
<!--
  The ApiKey below is not a credential. It is a constant handed to a container that the run creates
  and destroys, published on the loopback address only, and it authenticates against nothing else.
  Port is the port inside the container; nothing in this repository names a host port, because the
  host port is assigned by Docker and read back at run time.

  This is the only copy. generator/verify_image.py reads it, and the integration test fixture reads
  it too, so the two cannot disagree on the key.
-->
<Config>
  <ApiKey>0123456789abcdef0123456789abcdef</ApiKey>
  <AuthenticationMethod>None</AuthenticationMethod>
  <AuthenticationRequired>DisabledForLocalAddresses</AuthenticationRequired>
  <Port>6969</Port>
  <BindAddress>*</BindAddress>
  <Branch>v2</Branch>
  <LogLevel>info</LogLevel>
</Config>
